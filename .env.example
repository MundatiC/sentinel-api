# Copy to .env for local development. NEVER commit the real .env file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 = none). Needed so rate limiting and
# audit logs see the real client IP instead of the proxy's. Do not set higher than reality:
# clients could then spoof their IP with an X-Forwarded-For header.
TRUST_PROXY=0

# PostgreSQL connection string (used from step 2 onward).
DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel
