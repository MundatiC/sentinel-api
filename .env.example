# Copy to .env for local development. NEVER commit the real .env file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 = none). Needed so rate limiting and
# audit logs see the real client IP instead of the proxy's. Do not set higher than reality:
# clients could then spoof their IP with an X-Forwarded-For header.
TRUST_PROXY=0

# PostgreSQL connection string (used from step 2 onward).
DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel

# --- Auth (step 2) ---
# Signing key for access tokens, 32+ chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Self-registration is off by default. Registered users are always viewers.
ALLOW_REGISTRATION=false

# First admin, created by `npm run db:seed`. Use a strong password (12+ chars) and change it after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-something-long

# Postgres password used by docker-compose.
POSTGRES_PASSWORD=change-me

# --- Rate limits (requests per window) ---
GLOBAL_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MINUTES=15
